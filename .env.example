# Copy to .env and fill in the two values from your Spotify app at
# https://developer.spotify.com/dashboard
#
# That app also needs http://127.0.0.1:8888/callback registered as a Redirect
# URI, matched exactly, or authorization fails with "redirect_uri: Not matching
# configuration".
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Fetched for you by the auth flow on first run — leave this blank.
SPOTIFY_REFRESH_TOKEN=

# Only if your dashboard has a different Redirect URI registered.
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
